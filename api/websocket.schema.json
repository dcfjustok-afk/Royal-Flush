{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royal-flush.local/schemas/websocket.schema.json",
  "title": "RoyalFlushWebSocketContract",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/ClientCommand" },
    { "$ref": "#/$defs/RoomEvent" }
  ],
  "$defs": {
    "ChipDenomination": {
      "type": "integer",
      "enum": [5, 10, 20, 50, 100, 200, 500, 1000]
    },
    "ClientCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "expectedVersion", "payload"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "room.ready", "game.start", "action.raise", "action.call", "action.check",
            "action.fold", "action.all_in", "room.refill", "room.leave", "room.quick_message",
            "voice.mute", "room.remove_player", "room.rotate_invite", "room.transfer_owner", "room.end"
          ]
        },
        "requestId": { "type": "string", "minLength": 1 },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/RaisePayload" },
            { "$ref": "#/$defs/ReadyPayload" },
            { "$ref": "#/$defs/QuickMessagePayload" },
            { "$ref": "#/$defs/MutePayload" },
            { "$ref": "#/$defs/RemovePlayerPayload" },
            { "$ref": "#/$defs/TransferOwnerPayload" },
            { "type": "object", "maxProperties": 0 }
          ]
        }
      }
    },
    "RaisePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chips"],
      "properties": {
        "chips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ChipDenomination" } }
      }
    },
    "ReadyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": { "ready": { "type": "boolean" } }
    },
    "QuickMessagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string", "enum": ["好牌", "稍等一下", "打得漂亮", "下一手"] } }
    },
    "MutePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "muted"],
      "properties": { "userId": { "type": "string" }, "muted": { "type": "boolean" } }
    },
    "RemovePlayerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": { "userId": { "type": "string" } }
    },
    "TransferOwnerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": { "userId": { "type": "string" } }
    },
    "RoomEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "roomId", "version", "sentAt", "payload"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "table.snapshot", "room.player_joined", "room.player_disconnected", "room.player_reconnected", "room.player_profile_updated", "room.ready_changed", "room.player_leaving", "room.player_removed",
            "room.table_points_refilled", "room.quick_message", "room.invite_rotated",
            "room.owner_transferred", "room.ended", "game.hand_started", "game.action_applied",
            "game.action_timed_out", "score.self_added", "score.global_reset",
            "score.settlement_applied", "voice.mute_changed", "error"
          ]
        },
        "requestId": { "type": "string" },
        "roomId": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 },
        "sentAt": { "type": "string", "format": "date-time" },
        "payload": true
      }
    }
  }
}
