# Selects the root-level Dockerfile.server. Use the suffix only.
ZBPACK_DOCKERFILE_NAME=server

# Player accounts use phone + password; production cookies require this mode.
ENVIRONMENT=production
DATABASE_URL=${POSTGRES_CONNECTION_STRING}
REDIS_URL=${REDIS_CONNECTION_STRING}
INSTANCE_ID=${ZEABUR_SERVICE_ID}

# Replace with one or more comma-separated, authorized mainland China phone numbers.
ADMIN_ACCOUNT=YOUR_ADMIN_ACCOUNT
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Optional: LiveKit is preferred when all three values are present.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser WebRTC fallback. Add a TURN URL and credentials for restrictive networks.
VOICE_ICE_URLS=stun:stun.l.google.com:19302
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=
