# Local-only defaults. Replace every credential before using a shared environment.
POSTGRES_DB=royal_flush
POSTGRES_USER=royal_flush
POSTGRES_PASSWORD=royal_flush_dev
DATABASE_URL=postgres://royal_flush:royal_flush_dev@localhost:5432/royal_flush?sslmode=disable
REDIS_URL=redis://localhost:6379/0

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret
# LiveKit 未配置时使用浏览器 WebRTC。生产建议同时配置 TURN。
VOICE_ICE_URLS=stun:stun.l.google.com:19302
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_USER_IDS=local-admin
INSTANCE_ID=local-1
PORT=8080
ENVIRONMENT=development
